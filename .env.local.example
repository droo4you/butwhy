# ButWhy — copy to .env.local for local development.
# On Vercel, set the same names under Project → Settings → Environment Variables
# for Production and Preview. Redeploy after changing them.
#
# Never put an API key behind a NEXT_PUBLIC_ prefix. Keys are read only on the server.

# auto | groq | gemini | openai | claude | mock
#
# auto (default) uses the cheapest configured provider that has a key:
#   1. Groq  llama-3.1-8b-instant
#   2. Gemini gemini-2.5-flash-lite
#   3. OpenAI gpt-4o-mini
#   4. Claude claude-haiku-4-5-20251001
# A named provider is used alone, so a fallback cannot surprise you with a pricier bill.
# mock is for local testing only. It writes cards that say "Practice answer"
# in the text itself. It is ignored when VERCEL_ENV=production.
#
# With no key at all, the 32 shelf questions and 6 typed questions that match
# them still go four whys past the opening answer. The next tap says the
# trail pauses. Nothing is invented to fill the gap.
LLM_PROVIDER=auto

# Optional. Used only when LLM_PROVIDER names a single provider.
# In auto mode, set the per-provider variable instead, or a Groq model name
# would be sent to Gemini.
# LLM_MODEL=

# Recommended. Free-tier friendly and the cheapest default.
# https://console.groq.com
# If your plan does not list llama-3.1-8b-instant, set GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Alternative. The key is sent as the x-goog-api-key header, not in the URL.
# https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Live model calls allowed on one server instance before new live questions pause.
# Written trails do not count, and a cached repeat does not count.
# On Vercel this memory resets per instance. It is a brake, not a global quota.
LLM_CALL_BUDGET=200

# Public URL for metadata. Not a secret.
NEXT_PUBLIC_SITE_URL=https://butwhy-droo4you.vercel.app

# Unused. Saved shareable trails were never wired up. Leave these unset.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
